services:
  remnanode:
    container_name: remnanode
    hostname: remnanode
    image: remnawave/node:latest
    network_mode: host
    restart: always
    cap_add:
      - NET_ADMIN
    ulimits:
      nofile:
        soft: 1048576
        hard: 1048576
    environment:
      - NODE_PORT={{ remnanode_api_port }}
      - SECRET_KEY={{ remnanode_secret_key }}
    volumes:
      - "{{ remnanode_log_dir }}:/var/log/remnanode"
