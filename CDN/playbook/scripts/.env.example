# Укажите RC-файл и OS_PASSWORD либо удалите VKCS_OPENRC_FILE и заполните OS_*.
# Токен и CDN endpoint получаются автоматически через Keystone.
VKCS_OPENRC_FILE="/path/to/project-openrc.sh"
OS_AUTH_URL="https://msk.cloud.vk.com/infra/identity/v3/"
OS_PROJECT_ID="00000000000000000000000000000000"
OS_REGION_NAME="RegionOne"
OS_USERNAME="user@example.com"
OS_USER_DOMAIN_ID=""
OS_USER_DOMAIN_NAME="users"
OS_INTERFACE="public"
OS_PASSWORD="replace-with-openstack-password"

# Account-owned API token с Zone Read и DNS Write.
CLOUDFLARE_ACCOUNT_ID="00000000000000000000000000000000"
CLOUDFLARE_API_TOKEN="cfat_replace_with_cloudflare_token"

# Yandex Cloud: авторизация берётся из настроенного yc CLI.
YANDEX_FOLDER_ID=""
YANDEX_CLI_PROFILE=""
YANDEX_CERTIFICATE_NAME="wowsecure"
