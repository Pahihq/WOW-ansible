server {
    listen 80 default_server;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name {{ primary_domain }};

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/{{ primary_domain }};
        default_type "text/plain";
        try_files $uri =404;
    }

    location / { return 444; }
}
