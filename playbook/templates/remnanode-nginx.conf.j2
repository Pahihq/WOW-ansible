worker_processes auto;
worker_rlimit_nofile 65535;

error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 8192;
    multi_accept on;
    use epoll;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    server_tokens off;
    charset utf-8;

    access_log /var/log/nginx/access.log;
    error_log /var/log/nginx/error.log warn;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;

    keepalive_timeout 75s;
    keepalive_requests 1000;

    client_max_body_size 50m;
    client_body_buffer_size 2m;

    client_header_buffer_size 16k;
    large_client_header_buffers 8 64k;

    reset_timedout_connection on;

    gzip on;
    gzip_vary on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        application/json
        application/javascript
        text/xml
        application/xml
        application/xml+rss
        image/svg+xml
        text/javascript;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:50m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    upstream xray_trojan_grpc {
        server {{ xray_grpc_listen }}:{{ xray_grpc_port }};
        keepalive 64;
    }

    server {
        listen 80;
        listen [::]:80;

        server_name {{ remnanode_domain }};

        location /.well-known/acme-challenge/ {
            root {{ web_root }};
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;

        http2 on;

        server_name {{ remnanode_domain }};

        ssl_certificate /etc/nginx/ssl/{{ remnanode_domain }}/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/{{ remnanode_domain }}/privkey.pem;

        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;

        root {{ web_root }};
        index index.html index.htm;

        location ^~ /{{ grpc_service_name }} {
            grpc_pass grpc://xray_trojan_grpc;

            grpc_set_header Host $host;
            grpc_set_header X-Real-IP $remote_addr;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            grpc_set_header X-Forwarded-Proto $scheme;
            grpc_set_header X-Forwarded-Host $host;

            grpc_read_timeout 1h;
            grpc_send_timeout 1h;

            client_body_timeout 60s;

            access_log off;

            error_page 502 = @grpc_error;
        }

        location @grpc_error {
            return 404;
        }

        location = /healthz {
            access_log off;
            default_type text/plain;
            return 200 "ok\n";
        }

        location ~* \.(css|js|svg|woff2?|ico|png|jpg|jpeg|webp|gif)$ {
            expires 30d;
            add_header Cache-Control "public, immutable";
            access_log off;
            try_files $uri =404;
        }

        location = /favicon.ico {
            access_log off;
            return 204;
        }

        location = /robots.txt {
            access_log off;
            log_not_found off;
            try_files $uri =404;
        }

        location / {
            try_files $uri $uri/ /index.html;
        }
    }
}
