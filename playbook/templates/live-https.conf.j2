server {
    listen 443 ssl http2 default_server;
    server_name {{ primary_domain }} {{ cdn_domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ primary_domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ primary_domain }}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    root /var/www/{{ primary_domain }};
    index index.html;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    location ^~ /api/stream/room {
        client_max_body_size 0;
        proxy_pass {{ xray_proxy_pass }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        send_timeout 3600s;
        add_header Cache-Control "no-store" always;
    }

    # This must remain after the xHTTP location above: all cabinet API routes
    # are served by the local Express backend, rather than the SPA fallback.
    location ^~ /api/ {
        proxy_pass http://127.0.0.1:{{ site_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    location ^~ /.well-known/acme-challenge/ {
        root /var/www/{{ primary_domain }};
        default_type "text/plain";
        try_files $uri =404;
    }

    location = /robots.txt {
        add_header Content-Type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    location / {
        expires 1h;
        add_header Cache-Control "public" always;
        try_files $uri $uri/ /index.html;
    }

    location ~* /(\.env|\.git|\.svn|\.aws|wp-login\.php|wp-admin|phpmyadmin|xmlrpc\.php) { return 444; }
}
