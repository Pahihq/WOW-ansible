[Unit]
Description=Run {{ speedtest_metrics_provider }} speedtest and export metrics for node_exporter
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Environment=HOME=/root
Environment=USER=root
Environment=LOGNAME=root
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=SPEEDTEST_PROVIDER={{ speedtest_metrics_provider }}
ExecStart={{ speedtest_metrics_script }}
TimeoutStartSec=420
