---
- name: Полностью удалить ds-guard
  hosts: docker_nodes
  become: true
  gather_facts: false
  ignore_unreachable: true

  vars:
    ds_guard_path: /usr/local/lib/ds-guard/ds-guard
    ds_guard_result_dir: /var/log/ds-guard
    logrotate_timer_override_dir: /etc/systemd/system/logrotate.timer.d

  tasks:
    - name: Остановить запущенный ds-guard
      ansible.builtin.command:
        argv:
          - pkill
          - --signal
          - TERM
          - --full
          - "{{ ds_guard_path }}"
      register: ds_guard_stop
      changed_when: ds_guard_stop.rc == 0
      failed_when: ds_guard_stop.rc not in [0, 1]

    - name: Подождать завершения ds-guard
      ansible.builtin.pause:
        seconds: 2
      when: ds_guard_stop.rc == 0

    - name: Принудительно остановить оставшийся ds-guard
      ansible.builtin.command:
        argv:
          - pkill
          - --signal
          - KILL
          - --full
          - "{{ ds_guard_path }}"
      register: ds_guard_kill
      changed_when: ds_guard_kill.rc == 0
      failed_when: ds_guard_kill.rc not in [0, 1]

    - name: Удалить файлы и каталоги ds-guard
      ansible.builtin.file:
        path: "{{ item }}"
        state: absent
      loop:
        - "{{ ds_guard_path | dirname }}"
        - "{{ ds_guard_result_dir }}"
        - /etc/logrotate.d/suricata
        - "{{ logrotate_timer_override_dir }}/override.conf"
      register: ds_guard_cleanup

    - name: Удалить пустой каталог override logrotate.timer
      ansible.builtin.command:
        argv:
          - rmdir
          - "{{ logrotate_timer_override_dir }}"
      register: logrotate_override_dir_cleanup
      changed_when: logrotate_override_dir_cleanup.rc == 0
      failed_when: false

    - name: Перечитать конфигурацию systemd
      ansible.builtin.systemd_service:
        daemon_reload: true
      when: >-
        (ds_guard_cleanup.changed | default(false)) or
        (logrotate_override_dir_cleanup.changed | default(false))

    - name: Применить штатное расписание logrotate
      ansible.builtin.systemd_service:
        name: logrotate.timer
        state: restarted
      failed_when: false
      when: >-
        (ds_guard_cleanup.changed | default(false)) or
        (logrotate_override_dir_cleanup.changed | default(false))
